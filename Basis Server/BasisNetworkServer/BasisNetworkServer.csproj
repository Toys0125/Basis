<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(ProjectDir)..\.props" />

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<Configurations>Debug;Release</Configurations>
		<BaseOutputPath>$(ProjectDir)..\..\Basis Server Export\$(MSBuildProjectName)\bin\</BaseOutputPath>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<LangVersion>13</LangVersion>
		<!-- The server contains RID-specific SIMD code; allow an executable publish RID to flow
		     through ProjectReference instead of treating this library as architecture-agnostic. -->
		<IsRidAgnostic>false</IsRidAgnostic>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>TRACE;DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="BasisNetworkServer\**" />
		<EmbeddedResource Remove="BasisNetworkServer\**" />
		<None Remove="BasisNetworkServer\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="System.Text.Json" Version="9.0.0" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
		<ProjectReference Include="..\BasisNetworkCore\BasisNetworkCore.csproj" />
		<ProjectReference Include="..\Contrib\Auth\Did\Did.csproj" />
		<ProjectReference Include="..\Contrib\Crypto\Crypto.csproj" />
		<ProjectReference Include="..\LiteNetLib\LiteNetLib.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- RID-specific publishes compile only the matching explicit SIMD backend. AnyCPU/package
	     builds intentionally define neither symbol and retain runtime ISA dispatch for portability. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<BasisTargetCpuFamily Condition="'$(RuntimeIdentifier)' != '' and ($([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-x64')) or $([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-x86')))">X86</BasisTargetCpuFamily>
		<BasisTargetCpuFamily Condition="'$(RuntimeIdentifier)' != '' and ($([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-arm64')) or $([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-arm')))">Arm</BasisTargetCpuFamily>
		<BasisTargetCpuFamily Condition="'$(BasisTargetCpuFamily)' == '' and ('$(PlatformTarget)' == 'x64' or '$(PlatformTarget)' == 'x86')">X86</BasisTargetCpuFamily>
		<BasisTargetCpuFamily Condition="'$(BasisTargetCpuFamily)' == '' and ('$(PlatformTarget)' == 'arm64' or '$(PlatformTarget)' == 'arm')">Arm</BasisTargetCpuFamily>
		<DefineConstants Condition="'$(BasisTargetCpuFamily)' == 'X86'">$(DefineConstants);BASIS_TARGET_X86</DefineConstants>
		<DefineConstants Condition="'$(BasisTargetCpuFamily)' == 'Arm'">$(DefineConstants);BASIS_TARGET_ARM</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BasisServerTests" />
		<InternalsVisibleTo Include="BasisRestApi.Tests" />
	</ItemGroup>
</Project>
